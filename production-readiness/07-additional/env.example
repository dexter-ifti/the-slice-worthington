# .env.example — The Slice app
# Copy to `.env.local` for local development. NEVER commit real values.
# Anything prefixed VITE_ is PUBLIC: it is bundled into the web app AND the APK/IPA.

# ---- Client (public) -------------------------------------------------------
VITE_APP_ENV=development            # development | preview | staging | production
VITE_SITE_URL=http://localhost:3000
VITE_SENTRY_DSN=                    # optional locally
VITE_ANALYTICS_KEY=                 # optional locally; leave empty to disable analytics
VITE_ANALYTICS_HOST=https://us.i.posthog.com
VITE_REMOTE_CONFIG_URL=             # post-launch: remote content/config JSON

# ---- CI only (set as GitHub Environment secrets, not in this file) ---------
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
#
# Android release signing
# ANDROID_KEYSTORE_BASE64=
# ANDROID_KEYSTORE_PATH=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=upload
# ANDROID_KEY_PASSWORD=
# PLAY_SERVICE_ACCOUNT_JSON=
#
# iOS signing / App Store Connect
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_KEY_P8_BASE64=
# MATCH_PASSWORD=
# MATCH_GIT_URL=
#
# Existing: iOS Simulator preview on Appetize
# APPETIZE_API_TOKEN=
# (APPETIZE_PUBLIC_KEY is a repository variable)
